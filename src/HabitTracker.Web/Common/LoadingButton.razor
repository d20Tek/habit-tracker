<button class="btn btn-sm btn-outline-light" type="button" @attributes="AdditionalAttributes"
        disabled="@_isLoading" @onclick="OnClickAsync">
    <span class="@_iconClass" aria-hidden="true"></span>
    <span class="@(string.IsNullOrEmpty(Label) ? "visually-hidden" :  "ms-1")" role="status">@Label</span>
</button>
