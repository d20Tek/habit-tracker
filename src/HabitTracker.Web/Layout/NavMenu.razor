@inject NavigationManager Navigation

<div class="top-row ps-3 navbar navbar-dark">
    <div class="container-fluid">
        <a class="navbar-brand" href="">Habit Tracker</a>
        <button title="Navigation menu" class="navbar-toggler" @onclick="ToggleNavMenu">
            <span class="navbar-toggler-icon"></span>
        </button>
    </div>
</div>

<div class="@(collapseNavMenu ? "collapse" : null) nav-scrollable" @onclick="ToggleNavMenu">
    <nav class="nav flex-column">
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="" Match="NavLinkMatch.All">
                <span class="bi bi-house-door-fill-nav-menu" aria-hidden="true"></span> Home
            </NavLink>
        </div>
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="categories">
                <span class="bi bi-list-nested-nav-menu" aria-hidden="true"></span> Categories
            </NavLink>
        </div>
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="habits">
                <span class="bi bi-list-task" aria-hidden="true" style="font-size: 1.25rem; top: -14px;"></span> Habits
            </NavLink>
        </div>
        <div class="nav-item px-3">
            <a @onclick="ToggleReports" class="nav-link d-flex justify-content-between align-items-center" style="cursor: pointer">
                <span>
                    <span class="bi bi-table me-2" aria-hidden="true" style="font-size: 1.25rem; top: 2px"></span>
                    Reports
                </span>
                <span class="bi @(isReportsExpanded ? "bi-chevron-up" : "bi-chevron-down")" style="top: -12px"></span>
            </a>

            <div class="ps-4 @(isReportsExpanded ? "d-block" : "d-none")">
                <NavLink class="nav-link" href="reports/today">Today</NavLink>
                <NavLink class="nav-link" href="reports/weekly">Weekly</NavLink>
                <NavLink class="nav-link" href="reports/monthly">Monthly</NavLink>
            </div>
        </div>
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="weighings">
                <span class="bi" aria-hidden="true" style="font-size: 1.25rem; top: -14px;">
                    <svg height="20px" width="20px" version="1.1" id="_x32_" xmlns="http://www.w3.org/2000/svg" xmlns:xlink="http://www.w3.org/1999/xlink" viewBox="0 0 512 512" xml:space="preserve" fill="#ffffff"><g id="SVGRepo_bgCarrier" stroke-width="0"></g><g id="SVGRepo_tracerCarrier" stroke-linecap="round" stroke-linejoin="round"></g><g id="SVGRepo_iconCarrier"> <style type="text/css">
                         </style> <g> <path class="st0" d="M455.998,0.004H56.002C25.063,0.011,0.008,25.067,0,56.006v399.989c0.008,30.938,25.063,55.994,56.002,56.002 h399.997c30.938-0.008,55.994-25.063,56.002-56.002V56.006C511.993,25.067,486.937,0.011,455.998,0.004z M479.999,455.994 c-0.007,6.68-2.664,12.579-7.032,16.969c-4.39,4.367-10.289,7.024-16.969,7.032H56.002c-6.68-0.008-12.579-2.664-16.969-7.032 c-4.367-4.39-7.023-10.289-7.031-16.969V56.006c0.008-6.68,2.664-12.579,7.031-16.977c4.39-4.359,10.289-7.016,16.969-7.023 h399.997c6.68,0.007,12.579,2.664,16.969,7.023c4.367,4.398,7.024,10.297,7.032,16.977V455.994z"></path> <path class="st0" d="M128.012,119.101l26.391,76.783H270.86l16.352-67.947l9.938,2.031l9.93,2.015l-10.696,63.9h61.212 l26.392-76.783C346.612,96.577,302.83,83.6,256.008,83.6C209.178,83.6,165.388,96.577,128.012,119.101z"></path> </g> </g></svg>
                </span>
                Weight
            </NavLink>
        </div>
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="weather">
                <span class="bi bi-cloud-sun" aria-hidden="true" style="font-size: 1.25rem; top: -14px;"></span> Weather
            </NavLink>
        </div>
    </nav>
</div>
