@page "/reports/monthly";
@using HabitTracker.Web.Features.Habits.Components
@inject HttpClient _http;
@inject ILogger<WeeklyReport> _log;
@attribute [Authorize]

<PageTitle>Habit Tracker - Monthly Report</PageTitle>
<h3>Monthly Report</h3>
<p>Review that status of your habits for the last month.</p>

@if (_habits is null)
{
    <p><em>Loading...</em></p>
}
else if (_habits.Length <= 0)
{
    <NoHabitsDisplay />
}
else
{
    <div class="col-12 d-flex justify-content-center">
        <table class="table table-sm table-bordered table-striped">
            <thead>
                <tr>
                    <th class="col">Name</th>
                    <th class="col">Month's Status</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var habit in _habits)
                {
                    <tr>
                        <td>
                            @habit.Name
                            <a href=@Constants.Habits.DetailsUrl(habit.Id)>
                                <i class="bi bi-link-45deg mx-2"></i>
                            </a>
                        </td>
                        <td class="text-center">
                            <MonthCompletionGrid Habit=habit />
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

<DisplayErrors Errors=@_errors />
