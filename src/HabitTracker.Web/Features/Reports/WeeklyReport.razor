@page "/reports/weekly";
@using HabitTracker.Web.Features.Habits
@using HabitTracker.Web.Features.Habits.Components
@inject HttpClient _http;
@inject ILogger<WeeklyReport> _log;
@attribute [Authorize]

<PageTitle>Habit Tracker - Weekly Report</PageTitle>
<h3>Weekly Report</h3>
<p>Review that status of your habits for the last week.</p>

@if (_habits is null)
{
    <LoadingSpinner Label="Loading habits..." />
}
else if (_habits.Length <= 0)
{
    <NoHabitsDisplay />
}
else
{
    <div class="col-12 d-flex justify-content-center">
        <table class="table table-sm table-bordered table-striped habit-table">
            <thead>
                <tr>
                    <th class="col">Name</th>
                    @foreach(var date in _dateRange)
                    {
                    <th class="col text-center">@date.ToString("MM/dd")</th>
                    }
                </tr>
            </thead>
            <tbody>
            @foreach (var habit in _habits)
            {
                <tr>
                    <td>
                        @habit.Name
                        <a href=@Constants.Habits.DetailsUrl(habit.Id)>
                            <i class="bi bi-link-45deg mx-2"></i>
                        </a>
                    </td>
                    @foreach(var date in _dateRange)
                    {
                    <td class="text-center">
                        <CompletionMark Habit=habit Date=date />
                    </td>
                    }
                </tr>
            }
            </tbody>
        </table>
    </div>
}

<DisplayErrors Errors=@_errors />
