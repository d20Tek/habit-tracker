@inject HttpClient _http;
@inject ILogger<ListHabits> _log;
@attribute [Authorize]

@if (ShowHeader)
{
<h3>My Habits</h3>
<p>Track the completion of your habits on a daily basis.</p>
}

@if (_habits is null)
{
    <p><em>Loading...</em></p>
}
else if (_habits.Length <= 0)
{
    <div>There are no habits defined... <a href="habit/add">let's add some</a>.</div>
}
else
{
    <div class="col-12 col-lg-8 d-flex justify-content-center">
        <table class="table table-sm table-bordered table-striped">
            <thead>
                <tr>
                    <th class="col">Name</th>
                    <th class="col text-center">Status</th>
                    <th class="col text-center"></th>
                    <th class="col text-center"></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var habit in _habits)
                {
                    <tr>
                        <td>
                            @habit.Name<a href=@Constants.Habits.DetailsUrl(habit.Id)>
                            <i class="bi bi-link-45deg mx-2"></i></a>
                        </td>
                        <td class="text-center">@habit.ToCompletionString(Date)</td>
                        <td class="text-center">
                            <button class="btn btn-sm btn-outline-light" title="Mark habit completion"
                                    onclick=@(() => OnMarkClicked(habit.Id))>
                                <img class="bi bi-clipboard2-check" />
                            </button>
                            <button class="btn btn-sm btn-outline-light" title="Unmark habit completion" 
                                    onclick=@(() => OnUnmarkClicked(habit.Id))>
                                <img class="bi bi-clipboard2-minus" />
                            </button>
                        </td>
                        <td class="text-center">
                        @if(habit.IsCompleted(Date))
                        {
                            <img class="bi bi-check-circle-fill" style="color: green" />
                        }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@if (_errorMessage.IsSome && _errorMessage.Get() is string error)
{
    <div class="mt-3">@error</div>
}
