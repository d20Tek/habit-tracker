@page "/habits"
@page "/habits/list"
@inject HttpClient _http;
@inject ILogger<ListHabits> _log;
@attribute [Authorize]

<PageTitle>Habit Tracker - Habits</PageTitle>
<h3>Habits</h3>
<p>Here are a list of the habits that you are tracking.</p>

@if (_habits is null)
{
    <p><em>Loading...</em></p>
}
else if (_habits.Length <= 0)
{
    <div>There are no habits defined... let's add some.</div>
}
else
{
    <div class="col-12 d-flex justify-content-center">
        <table class="table table-sm table-bordered table-striped">
            <thead>
                <tr>
                    <th class="col text-center d-none d-md-table-cell">Id</th>
                    <th class="col">Name</th>
                    <th class="col text-center">
                        <span class="d-inline d-md-none" title="Attempts">Att</span>
                        <span class="d-none d-md-inline">Attempts</span>
                    </th>
                    <th class="col">Category</th>
                    <th class="col"></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var habit in _habits)
                {
                    <tr>
                        <td class="text-center d-none d-md-table-cell">@habit.Id</td>
                        <td>@habit.Name</td>
                        <td class="text-center">@habit.TargetAttempts</td>
                        <td>@habit.Category.Name</td>
                        <td class="text-center mx-0 px-1" style="min-width: 64px;">
                            <a class="mx-1" href=@Constants.Habits.EditUrl(habit.Id)>
                                <img class="bi bi-pencil text-white-50"/>
                            </a>
                            <a class="mx-1" href=@Constants.Habits.DeleteUrl(habit.Id)>
                                <img class="bi bi-trash3 text-white-50"/>
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

<DisplayErrors Errors=@_errors />
<div class="mt-2"><a class="btn btn-outline-light" href=@Constants.Habits.AddUrl>Add Habit</a></div>
