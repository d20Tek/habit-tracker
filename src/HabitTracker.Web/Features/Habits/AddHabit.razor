@page "/habit/add"
@inject HttpClient _http;
@inject NavigationManager _nav;
@inject ILogger<AddHabit> _log;
@attribute [Authorize]

<PageTitle>Budget Tracker - Habit</PageTitle>
<div class="col-12 border border-secondary p-2">
    <h3>New Habit</h3>
    <p>Add the new habit that you wish to track.</p>

    <EditForm class="mx-2" Model="@_vm" OnValidSubmit="CreateHabit">
        <div class="mb-3">
            <label for="habitName" class="form-label">Name</label>
            <InputText id="habitName" class="form-control" required @bind-Value="_vm.Name"
                       maxlength=@Constants.Habits.NameLength placeholder="Habit name" />
        </div>

        <div class="mb-3">
            <label for="habitDesc" class="form-label">Description</label>
            <InputText id="habitDesc" class="form-control" @bind-Value="_vm.Description"
                       maxlength=@Constants.Habits.DescLength placeholder="Short description of the habit" />
        </div>

        <div class="mb-3">
            <label for="habitAttempts" class="form-label">Target Attempts</label>
            <InputNumber id="habitAttempts" class="form-control" required @bind-Value="_vm.TargetAttempts"
                         min=1 max="100" />
        </div>

        <div class="mb-3">
            <label for="habitCategory" class="form-label">Category</label>
            <InputSelect id="habitCategory" class="form-control" required @bind-Value="_vm.CategoryId">
            @foreach(var cat in _categories)
            {
                <option value="@cat.Id">@cat.Name</option>
            }
            </InputSelect>
        </div>

        <button type="submit" class="btn btn-light me-2">Create</button>
        <button type="button" class="btn btn-secondary" @onclick=CancelHandler>Cancel</button>
    </EditForm>

    <DisplayErrors Errors=@_errors />
</div>
