@page "/habit/detail/{Id:int}"
@using HabitTracker.Web.Features.Habits.Components
@inject HttpClient _http;
@inject NavigationManager _nav;
@inject ILogger<EditHabit> _log;
@attribute [Authorize]

<PageTitle>Budget Tracker - Habits</PageTitle>
<h3>Habit Details</h3>

@if (_habit.IsSome && _habit.Get() is HabitResponse habit)
{
    <div><b>Id:</b> @habit.Id</div>
    <div><b>Name:</b> @habit.Name</div>
    <div><b>Description:</b> @habit.Description</div>
    <div><b>Category:</b> @habit.Category.Name</div>
    <div><b>Target Attempts:</b> @habit.TargetAttempts</div>
    <hr />

    <div class="btn-group" role="group" aria-label="Component selector">
        <button class="btn btn-outline-light @GetButtonCss(ViewType.Weekly)"
                @onclick="() => ChangeView(ViewType.Weekly)">
            Weekly</button>
        <button class="btn btn-outline-light @GetButtonCss(ViewType.Monthly)"
                @onclick="() => ChangeView(ViewType.Monthly)">
            Monthly</button>
        <button class="btn btn-outline-light @GetButtonCss(ViewType.PastDate)"
                @onclick="() => ChangeView(ViewType.PastDate)">
            Mark Past Dates</button>
    </div>

    <div class="mt-3">
        @if (SelectedView == ViewType.Weekly)
        {
        <WeeklyCompletionTable Habit=@habit />
        }
        else if (SelectedView == ViewType.Monthly)
        {
        <DetailsMonthlyView HabitId=@habit.Id />
        }
        else if (SelectedView == ViewType.PastDate)
        {
        <MarkPastDateComponent Habit=@habit />
        }
    </div>
}

<DisplayErrors Errors=@_errors />
