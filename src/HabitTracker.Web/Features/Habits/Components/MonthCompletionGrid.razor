<div class="grid-container" @attributes=AdditionalAttributes>
@for (int row = 0; row < Constants.HabitMonth.Rows; row++)
{
    @for (int col = 0; col < Constants.HabitMonth.Columns; col++)
    {
    var day = _calendarGrid[row, col];
    <div class="grid-cell" style="background-color: @day.Color" title="@day.CompletionDisplay"></div>
    }
}
</div>
