@inject HttpClient _http;
@inject ILogger<ListHabits> _log;

<h4>Weekly Completions</h4>
@if (Habit.IsSome && Habit.Get() is HabitResponse habit)
{
    <div class="col-12 d-flex justify-content-center">
        <table class="table table-sm table-bordered table-striped">
            <thead>
                <tr>
                    <th class="col">Date</th>
                    <th class="col text-center">Status</th>
                    <th class="col text-center"></th>
                    <th class="col text-center"></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var date in _dateRange)
                {
                    <tr>
                        <td>@date.ToString("MMM dd, yyyy")</td>
                        <td class="text-center">@habit.ToCompletionString(date)</td>
                        <td class="text-center">
                            <button class="btn btn-sm btn-outline-light" title="Mark habit completion"
                                    onclick=@(() => OnMarkClicked(habit.Id, date))>
                                <img class="bi bi-clipboard2-check" />
                            </button>
                            <button class="btn btn-sm btn-outline-light" title="Unmark habit completion"
                                    onclick=@(() => OnUnmarkClicked(habit.Id, date))>
                                <img class="bi bi-clipboard2-minus" />
                            </button>
                        </td>
                        <td class="text-center">
                            <CompletionMark Habit=habit Date=date ShowCompletionTitle=false />
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

<DisplayErrors Errors=@_errors />
