@page "/habit/edit/{Id:int}"
@inject HttpClient _http;
@inject NavigationManager _nav;
@inject ILogger<EditHabit> _log;
@attribute [Authorize]

<PageTitle>Budget Tracker - Habits</PageTitle>
<div class="col-12 border border-secondary p-2">
    <h3>Edit Habit</h3>
    <p>Change this habit's information.</p>

    @if (_vm.IsSome && _vm.Get() is ViewModel habit)
    {
        <EditForm class="mx-2" Model="@habit" OnValidSubmit="SaveHabit">
            <div class="mb-3">
                <label for="habitId" class="form-label"><span class="me-2">Id:</span> @habit.Id</label>
            </div>
            <div class="mb-3">
                <label for="habitName" class="form-label">Name</label>
                <InputText id="habitName" class="form-control" required @bind-Value="habit.Name"
                           maxlength=@Constants.Habits.NameLength placeholder="Habit name" />
            </div>
            <div class="mb-3">
                <label for="habitDesc" class="form-label">Description</label>
                <InputText id="habitDesc" class="form-control" @bind-Value="habit.Description"
                           maxlength=@Constants.Habits.DescLength placeholder="Short description of the habit" />
            </div>

            <div class="mb-3">
                <label for="habitAttempts" class="form-label">Target Attempts</label>
                <InputNumber id="habitAttempts" class="form-control" required @bind-Value="habit.TargetAttempts"
                             min=1 />
            </div>

            <div class="mb-3">
                <label for="habitCategory" class="form-label">Category</label>
                <InputSelect id="habitCategory" class="form-control" required @bind-Value="habit.CategoryId">
                    @foreach (var cat in _categories)
                    {
                        <option value="@cat.Id">@cat.Name</option>
                    }
                </InputSelect>
            </div>

            <button type="submit" class="btn btn-light me-2">Save</button>
            <button type="button" class="btn btn-secondary" @onclick=CancelHandler>Cancel</button>
        </EditForm>
    }

    <DisplayErrors Errors=@_errors />
</div>
