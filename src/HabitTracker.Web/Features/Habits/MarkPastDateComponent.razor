@inject HttpClient _http;
@inject ILogger<ListHabits> _log;

<h4>Mark Past Date</h4>
<p>Select past dates and mark or clear completion of this habit.</p>
@if (Habit.IsSome && Habit.Get() is HabitResponse habit)
{
<div class="my-2">
    <input type="date" style="width: 220px" @bind-value=@_date
           min="@Constants.Habits.MinDate" max="@Constants.Habits.MaxDate" />
</div>
<div class="my-2">
    <button class="btn btn-sm btn-outline-light" title="Mark habit completion"
            onclick=@(() => OnMarkClicked(habit.Id, _date))>
        <img class="bi bi-clipboard2-check" />
    </button>
    <button class="btn btn-sm btn-outline-light" title="Unmark habit completion"
            onclick=@(() => OnUnmarkClicked(habit.Id, _date))>
        <img class="bi bi-clipboard2-minus" />
    </button>
</div>
}

@if (displayMessage.IsSome && displayMessage.Get() is string error)
{
    <div class="mt-3">@error</div>
}
