@page "/"
@inject AuthenticationStateProvider AuthenticationStateProvider
@using HabitTracker.Web.Features.Habits
@using Microsoft.AspNetCore.Components.Authorization
@using System.Security.Claims

<PageTitle>Habit Tracker - Home</PageTitle>

<h3>Welcome to Habit Tracker!</h3>
<p>This app is your one-stop shop to building good habits by tracking your progress on a daily basis.</p>
<p>If you've followed systems that build good habits (like Atomic Habits), 
   you already know that tracking your progress is an essential step for improvement.</p>
<hr />

<AuthorizeView>
    <Authorized>
        <MarkHabitsComponent />
        <hr />

        <p>UserId: @id</p>
        <p>Email: @email</p>
    </Authorized>
    <NotAuthorized>
        <p>You are not logged in.</p>
    </NotAuthorized>
</AuthorizeView>

@code {
    private ClaimsPrincipal? user;
    private string? email;
    private string? claims;
    private string? id;

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        user = authState.User;

        if (user.Identity is { IsAuthenticated: true })
        {
            email = user.FindFirst(c => c.Type == "email")?.Value;
            id = user.FindFirst(c => c.Type == "sub")?.Value;
            claims = string.Join(", ", user.Claims.Select(c => $"{c.Type}: {c.Value}"));
        }
    }
}