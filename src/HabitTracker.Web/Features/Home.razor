@page "/"
@using HabitTracker.Web.Features.Habits.Components

<PageTitle>Habit Tracker - Home</PageTitle>

<h3>Welcome to Habit Tracker!</h3>
<div class="row">
    <div class="col-12 col-md-7 col-lg-8 col-xl-9">
        <p>This app is your one-stop shop to building good habits by tracking your progress on a daily basis.</p>
        <p>
            If you've followed systems that build good habits (like Atomic Habits),
            you already know that tracking your progress is an essential step for improvement.
        </p>

        <hr />
        <AuthorizeView>
            <Authorized>
                <MarkHabitsComponent />
                <hr />
            </Authorized>
            <NotAuthorized>
                <p>You are not logged in. Please <a href="authentication/login">log in</a> to see your data.</p>
            </NotAuthorized>
        </AuthorizeView>
    </div>
    <div class="col-12 col-md-5 col-lg-4 col-xl-3">
        <ContentLinksSidebar />
        <DonateButton />
    </div>
</div>
