<h5>Weight Over Time</h5>
<div class="weight-graph">
    <div class="y-axis">
    @foreach (var scale in _yAxisLabels)
    {
        <div class="y-axis-label">
            <span>@scale</span>
            <div class="y-axis-marker"></div>
        </div>
    }
    </div>

    <div class="bar-chart">
    @foreach(var weighing in _weighings)
    {
        <div class="@GetBarCss(weighing)" style="height: @weighing.WeightPct(_minWeight, _maxWeight)%;"
             title="@weighing.DisplayText()"
             @onclick="() => OnBarClicked(weighing)"/>
    }
    </div>
</div>

@if (_selectedWeighing.IsSome && _selectedWeighing.Get() is WeighingResponse weight)
{
    <div class="mt-2 text-center">@weight.DisplayText()</div>
}
