<h5>Weight Over Time</h5>
<div class="bar-chart">

    @for (int i = Weighings.Count() - 1; i >= 0; i--)
    {
        var weighing = Weighings[i];
        <div class="bar" style="height: @weighing.WeightPct(_minWeight, _maxWeight)%;" title="@weighing.DisplayText()" />
    }
</div>

@code {
    private decimal _maxWeight = Constants.Weighings.MaxWeight;
    private decimal _minWeight = Constants.Weighings.MinWeight;

    [Parameter]
    public List<WeighingResponse> Weighings { get; set; } = new();

    protected override void OnParametersSet()
    {
        _maxWeight = Weighings.Any() ? Weighings.MaxBy(x => x.Weight)!.Weight : 1;
        _minWeight = _maxWeight * Constants.Weighings.MinWeightFactor;
    }
}
