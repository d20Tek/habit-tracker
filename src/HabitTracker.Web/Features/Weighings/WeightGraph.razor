<h5>Weight Over Time</h5>
<div class="bar-chart">

    @foreach(var weighing in _weighings)
    {
        <div class="bar" style="height: @weighing.WeightPct(_minWeight, _maxWeight)%;" title="@weighing.DisplayText()" />
    }
</div>

@code {
    private IEnumerable<WeighingResponse> _weighings = [];
    private decimal _maxWeight = Constants.Weighings.MaxWeight;
    private decimal _minWeight = Constants.Weighings.MinWeight;

    [Parameter]
    public List<WeighingResponse> Weighings { get; set; } = new();

    protected override void OnParametersSet()
    {
        _weighings = Weighings.Take(Constants.Weighings.WeightGraphMaxColumns).Reverse();
        if (Weighings.Any())
        {
            _maxWeight = Weighings.MaxBy(x => x.Weight)!.Weight;

            decimal recordedMinWeight = _weighings.MinBy(x => x.Weight)!.Weight;
            _minWeight = Math.Min(recordedMinWeight - 5, _maxWeight - 10);
        }
    }
}
