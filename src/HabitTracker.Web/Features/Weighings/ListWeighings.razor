@page "/weighings"
@page "/weighings/list"
@inject HttpClient _http;
@inject ILogger<ListWeighings> _log;
@attribute [Authorize]

<PageTitle>Habit Tracker - Weighings</PageTitle>
<h3>My Weighings</h3>
<p>Track your weight on a daily basis...</p>

<div class="d-flex flex-nowrap align-items-center mb-3">
    <input type="date" min="2024-01-01" max="@DateTimeOffset.Now.ToString("yyyy-MM-dd")"
           @bind-value=_vm.Date />
    <input class="text-end mx-1 mx-md-2" type="number"
           min="@Constants.Weighings.MinWeight" max="@Constants.Weighings.MaxWeight"
           @bind-value=_vm.Weight />
    <LoadingButton class="btn btn-sm btn-outline-light flex-shrink-0 text-nowrap" IconClass=""
                   Label="Record Weight" OnClick=@OnRecordWeight />
</div>

<DisplayErrors Errors=@_errors />

@if (_weighings is null)
{
<p><em>Loading...</em></p>
}
else
{
<div class="row">
    <div class="col-12 col-xl-6 mb-3">
        <table class="table table-sm table-bordered table-striped">
            <thead>
                <tr>
                    <th class="col">Date</th>
                    <th class="col">Weight</th>
                    <th class="col"></th>
                </tr>
            </thead>
            <tbody>
            @foreach (var weighing in _weighings)
            {
                <tr>
                    <td>@weighing.Date.ToString("MMM dd, yyyy")</td>
                    <td>@($"{weighing.Weight:0.0}")</td>
                    <td class="text-center">
                        <LoadingButton IconClass="bi bi-trash3" style="width: 32px;"
                                       OnClick=@(() => OnDeleteWeighing(weighing.Id)) />
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
    <div class="col-12 col-xl-6">
        <WeightGraph Weighings=@_weighings />
    </div>
</div>
}
