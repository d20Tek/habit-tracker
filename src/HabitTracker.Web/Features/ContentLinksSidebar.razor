@inject ISessionStorageService _sessionStorage;
@inject HttpClient _http;
@inject ILogger<ContentLinksSidebar> _log;
@using HabitTracker.Web.Common;

<div class="side-panel">
    <div class="side-panel-heading">Helpful Links</div>

    @foreach (var link in _links)
    {
    <div class="side-panel-item">
        <a href="@link.Url" class="side-panel-title" title="@link.Title" target="_blank">
            @link.Title
        </a>
        @if (!string.IsNullOrWhiteSpace(link.Description))
        {
        <p class="side-panel-description">@link.Description</p>
        }
    </div>
    }
</div>
