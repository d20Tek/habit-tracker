@page "/categories/add"
@inject HttpClient _http;
@inject NavigationManager _nav;
@inject ILogger<AddCategory> _log;
@attribute [Authorize]

<PageTitle>Budget Tracker - Categories</PageTitle>
<div class="col-12 border border-secondary p-2">
    <h3>New Category</h3>
    <p>Here you can add custom categories that are just for you.</p>

    <EditForm class="mx-2" Model="@_vm">
        <div class="mb-3">
            <label for="categoryName" class="form-label">Name</label>
            <InputText id="categoryName" class="form-control" required @bind-Value="_vm.Name"
                       maxlength=@Constants.Categories.NameLength placeholder="Category name" />
        </div>

        <LoadingSubmitButton Label="Create" OnValidSubmit="CreateCategory" />
        <button type="button" class="btn btn-secondary ms-2" @onclick=CancelHandler>Cancel</button>
    </EditForm>

    <DisplayErrors Errors=@_errors />
</div>
