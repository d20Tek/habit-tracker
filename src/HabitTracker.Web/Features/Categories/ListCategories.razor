@page "/category"
@page "/category/list"
@inject HttpClient _http;
@attribute [Authorize]

<PageTitle>Habit Tracker - Categories</PageTitle>
<h3>Habit Categories</h3>

@if (_categories.Length <= 0 && _errorMessage.IsNone)
{
    <div>No habit categories are defined... please add some.</div>
}
else
{
    <div class="col-12 col-lg-8 d-flex justify-content-center">
        <table class="table table-sm table-bordered table-striped">
            <thead>
                <tr>
                    <th class="col-1 text-center">Id</th>
                    <th class="col-6 col-md-5">Name</th>
                    <th class="col-2 col-md-1"></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var category in _categories)
                {
                    <tr>
                        <td class="text-center">@category.CategoryId</td>
                        <td>@category.Name</td>
                        <td class="text-center">
                            <a href=@Constants.Categories.EditUrl(category.CategoryId)><img class="bi bi-pencil"/></a>
                            <a href=@Constants.Categories.DeleteUrl(category.CategoryId)><img class="bi bi-trash3"/></a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@if (_errorMessage.IsSome && _errorMessage.Get() is string error)
{
    <div class="mt-3">@error</div>
}

<div class="mt-2"><a class="btn btn-outline-primary" href=@Constants.Categories.AddUrl>Add Category</a></div>

@code {
    private CategoryResponse[] _categories = [];
    private Option<string> _errorMessage = Option<string>.None();

    protected override async Task OnInitializedAsync() =>
        _categories = await _http.TryGetFromJsonAsync<CategoryResponse[]>(Constants.Categories.ServiceUrl, [])
                                 .HandleErrorAsync(e => _errorMessage = e, []);
}
