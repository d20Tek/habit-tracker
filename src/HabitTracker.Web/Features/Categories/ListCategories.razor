@page "/categories"
@page "/categories/list"
@inject HttpClient _http;
@inject ILogger<ListCategories> _log;
@attribute [Authorize]

<PageTitle>Habit Tracker - Categories</PageTitle>
<h3>Habit Categories</h3>
<p>The following list provides a way for you to categorize different habits to help you focus on certain areas.</p>
<p>Every new habit needs a category, so you can review and add them here...</p>

@if (_categories is null)
{
    <p><em>Loading...</em></p>
}
else if (_categories.Length <= 0)
{
    <div>No habit categories are defined... please add some.</div>
}
else
{
    <div class="col-12 col-xl-8 d-flex justify-content-center">
        <table class="table table-sm table-bordered table-striped">
            <thead>
                <tr>
                    <th class="col-1 text-center">Id</th>
                    <th class="col-6 col-md-5">Name</th>
                    <th class="col-2 col-md-1"></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var category in _categories)
                {
                    <tr>
                        <td class="text-center">@category.Id</td>
                        <td>@category.Name</td>
                        <td class="text-center">
                            <a class="mx-1" href=@Constants.Categories.EditUrl(category.Id)>
                                <img class="bi bi-pencil text-white-50"/>
                            </a>
                            <a class="mx-1" href=@Constants.Categories.DeleteUrl(category.Id)>
                                <img class="bi bi-trash3 text-white-50"/>
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

<DisplayErrors Errors=@_errors />

<div class="mt-2"><a class="btn btn-outline-light" href=@Constants.Categories.AddUrl>Add Category</a></div>
