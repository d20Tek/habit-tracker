@page "/categories/delete/{Id:int}"
@inject HttpClient _http;
@inject NavigationManager _nav;
@inject ILogger<DeleteCategory> _log;
@attribute [Authorize]

<PageTitle>Budget Tracker - Categories</PageTitle>
<div class="col-12 border border-secondary p-2">
    <h3>Delete Category</h3>

    @if(_category.IsNone)
    {
        <LoadingSpinner Label="Loading category..." />
    }

    @if (_category.IsSome && _category.Get() is CategoryResponse cat)
    {
        <EditForm class="mx-2" Model="@cat">
            <div class="mb-3">
                <div class="form-label">
                    Are you sure that you want to delete the habit category with id=@cat.Id, named '@cat.Name'?
                </div>
            </div>

            <LoadingSubmitButton Label="Delete" OnValidSubmit="DeleteHandler" />
            <button type="button" class="btn btn-secondary ms-2" @onclick=CancelHandler>Cancel</button>
        </EditForm>
    }

    <DisplayErrors Errors=@_errors />
</div>
