@page "/category/edit/{Id:int}"
@inject HttpClient _http;
@inject NavigationManager _nav;
@inject ILogger<EditCategory> _log;
@attribute [Authorize]

<PageTitle>Budget Tracker - Categories</PageTitle>
<div class="col-12 border border-secondary p-2">
    <h3>Edit Category</h3>
    <p>Change this category's information.</p>

    @if (_vm.IsSome && _vm.Get() is ViewModel cat)
    {
        <EditForm class="mx-2" Model="@cat" OnValidSubmit="SaveCategory">
            <div class="mb-3">
                <label for="categoryId" class="form-label"><span class="me-2">Id:</span> @cat.Id</label>
            </div>

            <div class="mb-3">
                <label for="categoryName" class="form-label">Name</label>
                <InputText id="categoryName" class="form-control" required @bind-Value="cat.Name"
                           maxlength=@Constants.Categories.NameLength placeholder="Category name" />
            </div>

            <button type="submit" class="btn btn-light me-2">Save</button>
            <button type="button" class="btn btn-secondary" @onclick=CancelHandler>Cancel</button>
        </EditForm>
    }

    @if (_errorMessage.IsSome && _errorMessage.Get() is string error)
    {
        <div class="mt-3">@error</div>
    }
</div>
